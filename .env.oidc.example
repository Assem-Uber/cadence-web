# Copy to .env.local for OIDC POC against docker-compose-backend-services.yml
#
# Backend stack (from repo root):
#   docker compose -f docker-compose-backend-services.yml up -d
# Cadence uses docker/cadence/config/cadence-oauth-keycloak.yaml (Keycloak JWKS + internal OAuth key).
CADENCE_WEB_AUTH_STRATEGY=oidc
CADENCE_WEB_OIDC_ISSUER=http://localhost:8080/realms/cadence
CADENCE_WEB_OIDC_CLIENT_ID=cadence-web
CADENCE_WEB_OIDC_CLIENT_SECRET=cadence-web-secret
CADENCE_WEB_OIDC_REDIRECT_URI=http://localhost:8088/api/auth/oidc/callback
# Minimum 32 characters for JWE key material
CADENCE_WEB_OIDC_SESSION_SECRET=local-dev-oidc-session-secret-32b
# Optional: cap session lifetime for local timeout testing (restart npm run dev after change)
CADENCE_WEB_OIDC_DEV_SESSION_TTL_SECONDS=45
# Local Keycloak uses HTTP; auto-allowed outside production. In production an
# http issuer requires this explicit opt-in.
# CADENCE_WEB_OIDC_ALLOW_INSECURE=true
CADENCE_GRPC_PEERS=127.0.0.1:7833
