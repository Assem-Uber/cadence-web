{
  "realm": "cadence",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      { "name": "cadence-readers", "description": "Cadence read-only role" },
      { "name": "cadence-writers", "description": "Cadence write role" },
      { "name": "cadence-admin", "description": "Cadence admin role" }
    ]
  },
  "users": [
    {
      "username": "test-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "test-user@cadence.local",
      "attributes": {
        "picture": [
          "https://ui-avatars.com/api/?name=Test+User&background=276EF1&color=fff&size=128"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["cadence-readers"]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin-user@cadence.local",
      "attributes": {
        "picture": [
          "https://ui-avatars.com/api/?name=Admin+User&background=C62828&color=fff&size=128"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin-password",
          "temporary": false
        }
      ],
      "realmRoles": ["cadence-admin", "cadence-writers"]
    }
  ],
  "clients": [
    {
      "clientId": "cadence-web",
      "name": "Cadence Web",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "cadence-web-secret",
      "redirectUris": ["http://localhost:8088/api/auth/oidc/callback"],
      "webOrigins": ["http://localhost:8088"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8088/*"
      },
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    }
  ]
}
